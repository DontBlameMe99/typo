{
  "$schema": "https://t3.codes/schema/t3.json",
  "iconPath": "assets/icon.svg",
  "scripts": [
    {
      "name": "Setup Worktree",
      "command": "nix shell nixpkgs#bun -c bun install --frozen-lockfile",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Cleanup",
      "command": "command rm -rf .tmp node_modules dist .expo android/build coverage tsconfig.tsbuildinfo",
      "icon": "play",
      "runOnWorktreeCreate": false,
      "runOnSettle": true
    }
  ]
}
